      "checkConstraints": {
        "users_student_number_format_check": {
          "name": "users_student_number_format_check",
          "value": "(\"users\".\"user_type\" = 'teacher' AND \"users\".\"student_number\" IS NULL) OR (\"users\".\"student_number\" IS NOT NULL AND length(\"users\".\"student_number\") = 10 AND \"users\".\"student_number\" NOT GLOB '*[^0-9]*')"
        },
        "users_lcd_display_name_length_check": {
          "name": "users_lcd_display_name_length_check",
          "value": "(\"users\".\"user_type\" = 'teacher' AND \"users\".\"lcd_display_name\" IS NULL) OR (\"users\".\"lcd_display_name\" IS NOT NULL AND length(\"users\".\"lcd_display_name\") BETWEEN 1 AND 20)"
        },
        "users_user_type_check": {
          "name": "users_user_type_check",
          "value": "\"users\".\"user_type\" IN ('student', 'teacher')"
        },
        "users_face_image_count_check": {
