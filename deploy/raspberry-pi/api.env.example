API_HOST=127.0.0.1
API_PORT=3000
DATABASE_PATH=/var/lib/smart-gate/smart-gate.sqlite3
DATABASE_MIGRATIONS_PATH=/opt/smart-gate/apps/api/drizzle
AUTH_APP_BEARER_TOKEN=replace-with-a-long-random-event-token
FACE_AUTH_APP_URL=http://127.0.0.1:8001/
FACE_AUTH_APP_BEARER_TOKEN=replace-with-a-different-long-random-face-token
# LAN内HTTP用。HTTPSで配信する場合はtrueにする。
SESSION_COOKIE_SECURE=false
ATTENDANCE_RECEPTION_OPEN_MINUTES_BEFORE=10
ATTENDANCE_LATE_AFTER_MINUTES=20
ATTENDANCE_STANDARD_CLASS_DURATION_MINUTES=90
